# Copia este archivo como .env (para registrar comandos desde tu PC)
# y carga las mismas variables en Vercel → Settings → Environment Variables.

# Discord Developer Portal → General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Opcional: ID de tu servidor para que los comandos aparezcan al instante
DISCORD_GUILD_ID=

# Supabase → Connect → Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxx:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Una clave larga inventada por ti; protege el endpoint /api/tick
TICK_SECRET=
